{#
  scenario_id: entity_not_found_recovery
  scenario_category: K
  preconditions: >= 3 story entities
  description: |
    Assistant tries to read an entity with a wrong ID (error), recovers by
    searching, then reads with the correct ID.
#}
{%- import "_macros.j2" as m -%}
{%- set entities = project.story_entities -%}
{%- if entities | length >= 3 -%}
{%- set target = entities[0] -%}
{%- set bad_id = uuid4() -%}
{%- set error_result = {"error": {"code": "NOT_FOUND", "message": "Entity with id '" ~ bad_id ~ "' not found."}} -%}
{%- set search_result = {"pattern": target.name, "results": [{"type": "story_entity", "id": target.id, "name": target.name, "kind": target.kind, "excerpt": truncate(target.description, 100)}], "total": 1} -%}
{%- set read_result = {"id": target.id, "kind": target.kind, "name": target.name, "description": target.description, "content": truncate(target.content, 400), "created_at": now_iso(), "updated_at": now_iso()} -%}
{
  "scenario_id": "entity_not_found_recovery",
  "scenario_category": "K",
  "system": {{ m.system_prompt(project) | tojson }},
  "tools": {{ build_tools(["read_story_entity", "search_regex"]) }},
  "messages": [
    {{ m.user_msg("Can you pull up the profile for " ~ target.name ~ "?") }},
    {{ m.assistant_tool_turn(0, "read_story_entity", {"id": bad_id, "kind": target.kind}) }},
    {{ m.tool_result("read_story_entity", error_result) }},
    {{ m.assistant_answer(1, "That ID didn't work — the entity wasn't found. Let me search for " ~ target.name ~ " to find the correct one.") }},
    {{ m.assistant_tool_turn(2, "search_regex", {"pattern": target.name, "case_sensitive": false}) }},
    {{ m.tool_result("search_regex", search_result) }},
    {{ m.assistant_tool_turn(3, "read_story_entity", {"id": target.id, "kind": target.kind}) }},
    {{ m.tool_result("read_story_entity", read_result) }},
    {{ m.assistant_answer(4, "Found it! Here's **" ~ target.name ~ "**:\n\n**Description:** " ~ truncate(target.description, 150) ~ "\n\n**Content:** " ~ truncate(target.content, 250) ~ "\n\nWhat would you like to do with this?") }}
  ]
}
{%- endif -%}
