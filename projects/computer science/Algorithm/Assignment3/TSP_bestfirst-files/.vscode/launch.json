{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/gcc0.exe",
        "args": ["10"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "miDebuggerPath": "C:/program files/mingw64/bin/gdb.exe",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "internalConsoleOptions": "openOnSessionStart",
        "filterStderr": true,
        "filterStdout": false,
        "targetArchitecture": "x64",
        "logging": {
          "engineLogging": true
        }
      }
    ]
  }
  