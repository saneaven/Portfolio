        <mxCell id="i5NtFZeTg2HtFjPsXRbv-136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=1 4;endArrow=open;endFill=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="i5NtFZeTg2HtFjPsXRbv-135" target="i5NtFZeTg2HtFjPsXRbv-134">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i5NtFZeTg2HtFjPsXRbv-137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=1 4;endArrow=open;endFill=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="i5NtFZeTg2HtFjPsXRbv-135" target="i5NtFZeTg2HtFjPsXRbv-114">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i5NtFZeTg2HtFjPsXRbv-135" value="Just like the profile name,&amp;nbsp;&lt;div&gt;I split the host name into two for consistency.&lt;/div&gt;&lt;div&gt;(I didn&#39;t include the User ID because it may not be a user.)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacing=24;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="-40" y="710" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i5NtFZeTg2HtFjPsXRbv-139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=0.139;exitY=-0.028;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="i5NtFZeTg2HtFjPsXRbv-138" target="i5NtFZeTg2HtFjPsXRbv-93">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i5NtFZeTg2HtFjPsXRbv-138" value="Utilizing the characteristic of the constraint that doesn&#39;t allow the same person to appear multiple times in a single photo, I created a composite primary key by combining the photo ID and the ID of the tagged person in the photo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacing=24;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="-870" y="660" width="260" height="131" as="geometry" />
        </mxCell>
        <mxCell id="i5NtFZeTg2HtFjPsXRbv-141" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Goal and Business scope&lt;/h1&gt;&lt;p&gt;This ER diagram represents the data structure of a service called Imstagram, where an unlimited number of users can sign up, register their personal information (age, hometown, educational background etc.), share their photos, exchange private messages with other users, and create events that can be shared for other users to view.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;spacing=24;fillColor=default;strokeColor=default;shadow=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="-770" y="89" width="400" height="191" as="geometry" />
        </mxCell>
