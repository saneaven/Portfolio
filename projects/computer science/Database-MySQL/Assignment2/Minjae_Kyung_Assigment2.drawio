        </mxCell>
        <mxCell id="i5NtFZeTg2HtFjPsXRbv-126" value="We already have a location table.&amp;nbsp;&lt;div&gt;I think there is no reason to not use that.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;spacing=24;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="410" y="559" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i5NtFZeTg2HtFjPsXRbv-128" value="I understand that there are many possibilities for different locations, but I designed it this way because it can be utilized in many places with this structure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;spacingTop=0;spacing=24;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
